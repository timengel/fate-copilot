{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "app-data.v1.0.schema.json",
  "title": "Fate Copilot AppData v1.0",
  "description": "Historical reference schema for the app-data format before stressTracks were introduced.",
  "type": "object",
  "required": [
    "formatVersion",
    "exportDate",
    "campaigns",
    "characters",
    "campaignCharacterAssignments"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "formatVersion": {
      "type": "string",
      "enum": ["1.0"]
    },
    "exportDate": {
      "type": "string",
      "format": "date-time"
    },
    "campaigns": {
      "type": "array",
      "items": { "$ref": "#/$defs/Campaign" }
    },
    "characters": {
      "type": "array",
      "items": { "$ref": "#/$defs/Character" }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/Item" }
    },
    "campaignCharacterAssignments": {
      "type": "array",
      "items": { "$ref": "#/$defs/CampaignCharacterAssignment" }
    },
    "campaignItemAssignments": {
      "type": "array",
      "items": { "$ref": "#/$defs/CampaignItemAssignment" }
    },
    "characterItemAssignments": {
      "type": "array",
      "items": { "$ref": "#/$defs/CharacterItemAssignment" }
    },
    "skills": {
      "type": "array",
      "items": {
        "anyOf": [{ "type": "string" }, { "$ref": "#/$defs/AppSkill" }]
      }
    }
  },
  "$defs": {
    "Campaign": {
      "type": "object",
      "required": ["id", "name", "description", "status", "notes", "milestones"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["active", "inactive", "completed"]
        },
        "notes": { "type": "string" },
        "gmNotes": { "type": "string" },
        "color": { "$ref": "#/$defs/TagColor" },
        "avatar": { "type": "string" },
        "milestones": {
          "type": "array",
          "items": { "$ref": "#/$defs/Milestone" }
        }
      }
    },
    "Milestone": {
      "type": "object",
      "required": ["id", "type", "description"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["small", "significant", "major"]
        },
        "description": { "type": "string" }
      }
    },
    "Character": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "highConcept",
        "trouble",
        "aspects",
        "skills",
        "stunts",
        "extras",
        "refresh",
        "fatePoints",
        "stressPhysical",
        "stressMental",
        "consequences",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["sc", "nsc"]
        },
        "archived": { "type": "boolean" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "highConcept": { "type": "string" },
        "trouble": { "type": "string" },
        "aspects": {
          "type": "array",
          "items": { "type": "string" }
        },
        "skills": {
          "type": "array",
          "items": { "$ref": "#/$defs/SkillEntry" }
        },
        "stunts": {
          "type": "array",
          "items": { "$ref": "#/$defs/Stunt" }
        },
        "extras": { "type": "string" },
        "refresh": { "type": "integer", "minimum": 1 },
        "fatePoints": { "type": "integer", "minimum": 0 },
        "stressPhysical": {
          "type": "array",
          "items": { "$ref": "#/$defs/StressBox" }
        },
        "stressMental": {
          "type": "array",
          "items": { "$ref": "#/$defs/StressBox" }
        },
        "consequences": {
          "type": "array",
          "items": { "$ref": "#/$defs/Consequence" }
        },
        "notes": { "type": "string" },
        "gmNotes": { "type": "string" },
        "pyramidMaxLevel": { "type": "integer", "minimum": 1, "maximum": 8 },
        "pyramidMaxCols": { "type": "integer", "minimum": 1 },
        "color": { "$ref": "#/$defs/TagColor" },
        "avatar": { "type": "string" },
        "redDice": { "type": "integer", "minimum": 0, "maximum": 4 },
        "blueDice": { "type": "integer", "minimum": 0, "maximum": 4 },
        "modifiers": {
          "type": "array",
          "items": { "$ref": "#/$defs/Modifier" }
        },
        "pureDamage": { "type": "integer", "minimum": -8, "maximum": 8 },
        "deflection": { "type": "integer", "minimum": -8, "maximum": 8 }
      }
    },
    "Item": {
      "type": "object",
      "required": [
        "id",
        "type",
        "name",
        "description",
        "aspects",
        "stunts",
        "extras",
        "stressPhysical",
        "stressMental",
        "redDice",
        "blueDice"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["item"]
        },
        "archived": { "type": "boolean" },
        "hidden": { "type": "boolean" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "aspects": {
          "type": "array",
          "items": { "type": "string" }
        },
        "stunts": {
          "type": "array",
          "items": { "$ref": "#/$defs/Stunt" }
        },
        "extras": { "type": "string" },
        "stressPhysical": {
          "type": "array",
          "items": { "$ref": "#/$defs/StressBox" }
        },
        "stressMental": {
          "type": "array",
          "items": { "$ref": "#/$defs/StressBox" }
        },
        "gmNotes": { "type": "string" },
        "color": { "$ref": "#/$defs/TagColor" },
        "avatar": { "type": "string" },
        "redDice": { "type": "integer", "minimum": 0, "maximum": 4 },
        "blueDice": { "type": "integer", "minimum": 0, "maximum": 4 },
        "modifiers": {
          "type": "array",
          "items": { "$ref": "#/$defs/Modifier" }
        },
        "pureDamage": { "type": "integer", "minimum": -8, "maximum": 8 },
        "deflection": { "type": "integer", "minimum": -8, "maximum": 8 },
        "consequences": {
          "type": "array",
          "items": { "$ref": "#/$defs/Consequence" }
        }
      }
    },
    "TagColor": {
      "type": "string",
      "enum": [
        "pfau",
        "heidelbeere",
        "lavendel",
        "weintraube",
        "tomate",
        "erdbeere",
        "lachs",
        "koralle",
        "flamingo",
        "mandarine",
        "bernstein",
        "banane",
        "limette",
        "salbei",
        "basilikum",
        "hellgrau",
        "schiefer",
        "gray",
        "haselnuss",
        "zimt",
        "türkis",
        "rose"
      ]
    },
    "SkillEntry": {
      "type": "object",
      "required": ["skill", "level"],
      "additionalProperties": false,
      "properties": {
        "skill": { "type": "string" },
        "level": { "type": "integer", "minimum": 1, "maximum": 8 }
      }
    },
    "AppSkill": {
      "type": "object",
      "required": ["name", "description", "actions"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/AppSkillAction" }
        }
      }
    },
    "AppSkillAction": {
      "type": "object",
      "required": ["name", "examples"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "enum": ["Überwinden", "Vorteil erschaffen", "Angreifen", "Verteidigen"]
        },
        "examples": { "type": "string" }
      }
    },
    "Modifier": {
      "type": "object",
      "required": ["label", "value"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "value": { "type": "integer", "minimum": -8, "maximum": 8 }
      }
    },
    "Stunt": {
      "type": "object",
      "required": ["name", "description"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "StressBox": {
      "type": "object",
      "required": ["value", "checked"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "integer", "minimum": 1 },
        "checked": { "type": "boolean" }
      }
    },
    "Consequence": {
      "type": "object",
      "required": ["severity", "label", "value"],
      "additionalProperties": false,
      "properties": {
        "severity": {
          "type": "integer",
          "enum": [2, 4, 6, 8]
        },
        "label": {
          "type": "string",
          "enum": ["mild", "moderate", "severe", "extreme"]
        },
        "value": { "type": "string" }
      }
    },
    "CampaignCharacterAssignment": {
      "type": "object",
      "required": ["campaignId", "characterId"],
      "additionalProperties": false,
      "properties": {
        "campaignId": { "type": "string" },
        "characterId": { "type": "string" }
      }
    },
    "CampaignItemAssignment": {
      "type": "object",
      "required": ["campaignId", "itemId"],
      "additionalProperties": false,
      "properties": {
        "campaignId": { "type": "string" },
        "itemId": { "type": "string" }
      }
    },
    "CharacterItemAssignment": {
      "type": "object",
      "required": ["characterId", "itemId"],
      "additionalProperties": false,
      "properties": {
        "characterId": { "type": "string" },
        "itemId": { "type": "string" }
      }
    }
  }
}
